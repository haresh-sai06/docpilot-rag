{
  "family": "docpilot",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "docpilot",
      "image": "ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/docpilot:latest",
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "DOCPILOT_LLM_PROVIDER", "value": "openai" },
        { "name": "DOCPILOT_LLM_MODEL", "value": "gpt-4o-mini" }
      ],
      "secrets": [
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:docpilot/openai-key" }
      ],
      "healthCheck": { "command": ["CMD-SHELL", "python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/health')\""], "interval": 15, "retries": 3 },
      "logConfiguration": { "logDriver": "awslogs", "options": { "awslogs-group": "/ecs/docpilot", "awslogs-region": "ap-south-1", "awslogs-stream-prefix": "api" } }
    }
  ]
}
