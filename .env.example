# LLM provider: ollama | openai | none
DOCPILOT_LLM_PROVIDER=ollama
DOCPILOT_LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For any OpenAI-compatible API (OpenAI, Groq, Together, vLLM, ...):
# DOCPILOT_LLM_PROVIDER=openai
# DOCPILOT_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
DOCPILOT_CACHE=1
DOCPILOT_TOP_K=4
DOCPILOT_CANDIDATES=20
